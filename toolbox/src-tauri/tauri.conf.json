{
  "productName": "war-danmaku 工具箱",
  "version": "1.0.0",
  "identifier": "com.war-danmaku.toolbox",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:8760",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "war-danmaku 工具箱",
        "label": "main",
        "width": 860,
        "height": 600,
        "minWidth": 700,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
